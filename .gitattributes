# Fixture data must stay byte-identical on every platform. The installed tree is compared
# against ZIP entry contents, so an end-of-line conversion on checkout would make every
# fixture file look changed and would silently invalidate the update demo.
fixtures/** text eol=lf
fixtures/packages/*.zip binary

# The DTO fixtures are the same promise in the other direction: they are compared byte for
# byte against what Rust serializes, and serde ends its lines with \n. Converting them on
# checkout makes that comparison fail on a Windows clone while passing wherever the clone
# happened to keep \n -- a test that only runs where somebody is not looking.
apps/gkrm-desktop/src/services/tauri/fixtures/** text eol=lf

# The notices file is generated, with \n, and continuous integration regenerates it and
# compares the result. Converting it on checkout would make that comparison fail on every
# line for a file whose content had not changed at all.
THIRD-PARTY-NOTICES.txt text eol=lf
